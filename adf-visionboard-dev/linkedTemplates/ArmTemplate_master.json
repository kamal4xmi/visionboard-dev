					"LS_SQL_SERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_userName')]"
					},
					"LS_LKP_UP_properties_typeProperties_server": {
						"value": "[parameters('LS_LKP_UP_properties_typeProperties_server')]"
					},
					"LS_LKP_UP_properties_typeProperties_database": {
						"value": "[parameters('LS_LKP_UP_properties_typeProperties_database')]"
					},
					"LS_LKP_UP_properties_typeProperties_userName": {
						"value": "[parameters('LS_LKP_UP_properties_typeProperties_userName')]"
					},
					"LS_OnPrem_properties_typeProperties_server": {
						"value": "[parameters('LS_OnPrem_properties_typeProperties_server')]"
					},
					"LS_OnPrem_properties_typeProperties_database": {
						"value": "[parameters('LS_OnPrem_properties_typeProperties_database')]"
					},
					"LS_OnPrem_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnPrem_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
